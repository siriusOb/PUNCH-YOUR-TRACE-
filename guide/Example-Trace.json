    "metricDefinitions": {
      "app_active_duration": {
        "label": "App Active Duration",
        "unit": "seconds",
        "quantity": "duration",
        "definition": "Seconds during which the application was the frontmost one while the user was active (no idle, lock, sleep or pause). A stretch still open at the end counts until the recording ended.",
        "collected": true
      },
      "app_activation_count": {
        "label": "App Activation Count",
        "unit": "count",
        "quantity": "count",
        "definition": "How many times the application newly became the frontmost one (start of the recording or a switch to it). Coming back after idle, lock or pause does NOT add an activation.",
        "collected": true
      },
      "app_session_count": {
        "label": "App Session Count",
        "unit": "count",
        "quantity": "count",
        "definition": "Number of continuous active stretches of the application. Differs from the activation count whenever an idle, lock or pause interrupted a stretch.",
        "collected": true
      },
      "website_active_duration": {
        "label": "Website Active Duration",
        "unit": "seconds",
        "quantity": "duration",
        "definition": "Seconds during which the site (normalized domain) was the active page of the frontmost browser. A PART of that browser's application time — never add the two.",
        "collected": true
      },
      "website_activation_count": {
        "label": "Website Activation Count",
        "unit": "count",
        "quantity": "count",
        "definition": "How many times the site newly became the active one (start, switch of tab or site, browser brought to the front).",
        "collected": true
      },
      "app_transition_count": {
        "label": "App Transition Count",
        "unit": "count",
        "quantity": "count",
        "definition": "Number of switches from one application to a different one, as a directed matrix (row = from, column = to).",
        "collected": true
      },
      "website_transition_count": {
        "label": "Website Transition Count",
        "unit": "count",
        "quantity": "count",
        "definition": "Number of switches from one site to a different one (also across browsers), as a directed matrix.",
        "collected": true
      },
      "mouse_click_count": {
        "label": "Mouse Click Count",
        "unit": "count",
        "quantity": "count",
        "definition": "Number of button presses. macOS clicks (display coordinates) and clicks inside web pages (viewport coordinates) are counted separately and NOT added: a click on a page can appear in both.",
        "collected": true
      },
      "spatial_click_coordinates": {
        "label": "Spatial Click Coordinates",
        "unit": "normalized_0_1",
        "quantity": "position",
        "definition": "Click positions as x/y between 0 and 1 (origin top-left, y down) on their own display or page viewport, with the original coordinates and the display/viewport size.",
        "collected": true
      }
    },
    "measurementUnits": {
      "duration": "seconds (decimal, millisecond resolution). Requested, elapsed and observed-active durations are different measures.",
      "count": "whole numbers: activations, sessions, transitions and clicks are different counts",
      "ratio": "share between 0 and 1 (6 decimals)",
      "timestamp": "UTC epoch milliseconds (…Ms) with the local ISO-8601 time at that moment (…Local)",
      "timeOffset": "milliseconds since the recording started (…OffsetMs)",
      "normalizedPosition": "0..1, origin top-left, y grows downward, relative to the display or page viewport the click happened on",
      "displayCoordinates": "macOS points (Quartz), origin top-left of the display; width/height in points",
      "pageCoordinates": "CSS pixels inside the page viewport, origin top-left (not screen coordinates); scroll offsets are separate"
    },
